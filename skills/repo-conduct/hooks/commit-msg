#!/bin/sh
# repo-conduct: reject assistant attribution trailers in commit messages.
# Install once per clone: git config core.hooksPath <this-skill>/hooks
# Bypass one commit:      git commit --no-verify
[ -f "$1" ] || exit 0

if grep -v '^#' "$1" | grep -qiE \
	'noreply@(anthropic|openai|google)\.com|claude\.ai/code|^Claude-Session:|generated with \[|^Co-Authored-By: *(Claude|GPT|Copilot|Cursor|Codex|Gemini|Devin)'
then
	echo "commit-msg: assistant attribution trailer found." >&2
	echo "Remove it, or bypass this once with --no-verify." >&2
	exit 1
fi
