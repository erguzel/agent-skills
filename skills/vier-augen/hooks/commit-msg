#!/bin/sh
# vier-augen: reject assistant attribution - trailers, session links and
# markers in the message, and coding-agent identities as author or committer.
# Patterns live in attribution/ next to this file.
# Install: sh <this-skill>/hooks/install.sh   Bypass once: git commit --no-verify
[ -f "$1" ] || exit 0

dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/attribution
patterns() { grep -v -e '^#' -e '^[[:space:]]*$' "$dir/$1" 2>/dev/null; }
if ! msg=$(patterns message.ere) || ! ids=$(patterns identity.ere); then
	echo "commit-msg: attribution patterns missing in $dir." >&2
	exit 1
fi

found=0
if grep -v '^#' "$1" | grep -qiE -e "$msg"; then
	echo "commit-msg: assistant attribution found in the message." >&2
	found=1
fi
for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
	ident=$(git var "$var" 2>/dev/null) || continue
	ident=${ident% * *}
	if printf '%s\n' "$ident" | grep -qiE -e "$ids"; then
		echo "commit-msg: coding-agent identity in $var: $ident" >&2
		found=1
	fi
done

if [ "$found" -ne 0 ]; then
	echo "Remove it, or bypass this once with --no-verify." >&2
	exit 1
fi
exit 0
