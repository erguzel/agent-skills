#!/bin/sh
# vier-augen: stop a commit whose staged additions look like secrets or
# personal paths. A floor, not a scanner: the agent's own diff scan still runs.
# Install: sh <this-skill>/hooks/install.sh   Bypass once: git commit --no-verify

# Emit "file:line:text" for every added line in the staged diff.
added=$(git diff --cached --no-color --no-ext-diff -U0 --diff-filter=ACMR | awk '
	/^diff --git / { h = 1; next }
	h && /^\+\+\+ / { f = substr($0, 7); h = 0; next }
	/^@@/      { split($3, a, ","); n = substr(a[1], 2) + 0; next }
	/^\+/      { print f ":" n ":" substr($0, 2); n++ }
')
[ -n "$added" ] || exit 0

found=0
check() { # $1 label, $2 extended regex
	hits=$(printf '%s\n' "$added" | grep -E -e "$2" | cut -d: -f1-2)
	[ -n "$hits" ] || return 0
	found=1
	printf '%s\n' "$hits" | while IFS= read -r loc; do
		echo "pre-commit: possible $1 at $loc" >&2
	done
}

check "private key"          '-----BEGIN [A-Z ]*PRIVATE KEY-----'
check "AWS access key"       'AKIA[0-9A-Z]{16}'
check "GitHub token"         'gh[pousr]_[A-Za-z0-9]{36,}'
check "API key (sk-...)"     'sk-(ant-)?[A-Za-z0-9_-]{20,}'
check "Slack token"          'xox[abprs]-[A-Za-z0-9-]{10,}'
check "personal home path"   '/(Users|home)/[A-Za-z0-9][A-Za-z0-9._-]*/'

if [ "$found" -ne 0 ]; then
	echo "Values are not printed. Fix the lines, or bypass once with --no-verify." >&2
	exit 1
fi
exit 0
