#!/bin/sh
# vier-augen: refuse pushes that rewrite history on the remote
# (non-fast-forward, i.e. force-push). Branch creation and deletion pass.
# Install: sh <this-skill>/hooks/install.sh   Bypass once: git push --no-verify

remote="$1"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # deleting a remote ref
	case "$remote_sha" in *[!0]*) ;; *) continue ;; esac  # creating a remote ref
	if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		echo "pre-push: $remote_ref on $remote has commits you have not fetched; fetch first." >&2
		status=1
	elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
		echo "pre-push: $local_ref -> $remote_ref would rewrite history on $remote." >&2
		status=1
	fi
done
[ "$status" -eq 0 ] || echo "Bypass once with --no-verify if this is intended." >&2
exit "$status"
